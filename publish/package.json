{
  "name": "cinora-web",
  "version": "1.0.0",
  "private": true,
  "description": "Cinora.Web frontend asset pipeline — Tailwind CSS v4 + TypeScript (esbuild), Alpine.js + HTMX bundled locally.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "build": "npm run typecheck && node build.mjs",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@microsoft/signalr": "^8.0.7",
    "htmx.org": "^2.0.10"
  }
}
