<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test toolchain (xUnit) and IsPackable/IsTestProject are centralized in ../Directory.Build.props. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cinora.Application\Cinora.Application.csproj" />
  </ItemGroup>

  <!--
    SQLite in-memory (a single shared open connection) backs the deterministic race-path doubles (see
    TestAppDbContext / SharedSqliteStore); tests only. A REAL relational engine that ENFORCES the unique
    indexes, so a duplicate insert throws a genuine DbUpdateException — which EF Core InMemory cannot do.
    Microsoft.Data.Sqlite is referenced directly because the shared-store fixture news up a SqliteConnection.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!--
    NuGet audit suppression, scoped to this one advisory and this one test project. The SQLite bundle pulls
    the native SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries advisory GHSA-2m69-gcr7-jv3q; the fixed
    native build is not in the offline NuGet cache (local-only constraint), and this is a TEST-ONLY engine
    that never ships in any runtime artifact. Suppress exactly this advisory (not auditing broadly) so
    TreatWarningsAsErrors stays on for everything else. Revisit when a patched native bundle is cached.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
