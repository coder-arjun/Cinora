{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cinora-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "Tmdb": {
    "BaseUrl": "https://api.themoviedb.org/3",
    "ImageBaseUrl": "https://image.tmdb.org/t/p"
  },
  "Ai": {
    "Provider": "Ollama",
    "Endpoint": "http://localhost:11434/v1",
    "Model": "llama3.2",
    "TimeoutSeconds": 60,
    "MaxOutputTokens": 1024
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultTtlSeconds": 300
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/uploads",
    "PublicBasePath": "/uploads",
    "MaxUploadBytes": 5000000
  },
  "Email": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromName": "Cinora"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*"
}
