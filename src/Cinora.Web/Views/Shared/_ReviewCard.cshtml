@model ReviewVm
@{
    var posted = Model.CreatedAtUtc.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);
    var cardId = $"review-{Model.ReviewId}";
}

@*
    Milestone 3.1 — a single review card. XSS stance (§3): the body and display name are ALWAYS Razor
    output-encoded (@Model.Body / @Model.AuthorDisplayName) — never Html.Raw — and line breaks are presented
    with `white-space: pre-wrap`, never by turning "\n" into <br>. Edit/delete affordances render ONLY when
    IsMine and are attribute-driven HTMX (hx-get / hx-delete) — no inline JS, no hx-on — so the strict
    script-src 'self' CSP is untouched; the anti-forgery token rides the RequestVerificationToken header that
    Scripts/site.ts attaches to every HTMX request.
*@
@* tabindex="-1" + data-review-card: site.ts focuses this card after an HTMX swap replaces it (create /
   edit / cancel), so keyboard/SR focus is never dropped to <body> (WCAG 2.4.3). *@
<article id="@cardId" data-review-card tabindex="-1" class="card-glass p-5 sm:p-6">
    <header class="flex items-start gap-3">
        @* Milestone 4.2 Step B — the review author's real avatar (or the monogram fallback) via the shared _Avatar
           seam. Decorative: the author name link beside it already names the user (no double SR announcement). *@
        <partial name="_Avatar" model="new AvatarViewModel(Model.AuthorDisplayName, Model.AuthorAvatarFileKey, AvatarSize.Small, Decorative: true)" />

        <div class="min-w-0 flex-1">
            @* Author name links to their profile (/users/{id}) so profiles are reachable from any review. *@
            <a asp-controller="Profiles" asp-action="Profile" asp-route-id="@Model.AuthorUserId" title="@Model.AuthorDisplayName"
               class="block truncate text-sm font-semibold text-ink transition-colors hover:text-accent">@Model.AuthorDisplayName</a>
            <p class="text-xs text-ink-subtle">
                <time datetime="@Model.CreatedAtUtc.ToString("o", System.Globalization.CultureInfo.InvariantCulture)">@posted</time>
                @if (Model.UpdatedAtUtc is not null)
                {
                    <span class="ml-1">· edited</span>
                }
            </p>
        </div>

        <span class="inline-flex shrink-0 items-center gap-1 rounded-pill border border-white/10 bg-surface-2/80 px-3 py-1 text-sm font-semibold text-ink"
              role="img" aria-label="Rated @Model.Rating out of 10">
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-accent" aria-hidden="true">
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 .5l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
            </svg>
            <span aria-hidden="true">@Model.Rating<span class="text-ink-muted">/10</span></span>
        </span>
    </header>

    @* Plain text, output-encoded, with CSS-preserved line breaks (never raw HTML / <br>). *@
    <p class="mt-4 whitespace-pre-wrap break-words text-sm leading-relaxed text-ink-muted">@Model.Body</p>

    @* Milestone 3.2 — like toggle + comments toggle replace the static counts. Comfortable tap targets
       (≥24×24, WCAG 2.5.8): inline-flex + px-3 py-1.5 + min-h-9. *@
    <footer class="mt-4 flex flex-wrap items-center gap-3 text-xs text-ink-subtle">
        <partial name="_LikeButton" model="new LikeButtonVm(Model.ReviewId, Model.LikeCount, Model.LikedByMe)" />

        @* Comments disclosure (M7: aria-expanded flipped false→true by site.ts once the thread loads).
           data-comment-toggle + data-comment-count let site.ts keep the count fresh after an add/delete
           without a re-render (M5); the label lives in its own span so only the text is rewritten. *@
        <button type="button" data-comment-toggle data-comment-count="@Model.CommentCount"
                class="inline-flex min-h-9 items-center gap-1.5 rounded-btn px-3 py-1.5 font-medium text-ink-muted transition-colors hover:bg-white/5 hover:text-ink"
                hx-get="/reviews/@Model.ReviewId/comments"
                hx-target="#comment-thread-@Model.ReviewId"
                hx-swap="innerHTML"
                hx-trigger="click once"
                aria-controls="comment-thread-@Model.ReviewId"
                aria-expanded="false">
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 3c-4.31 0-8 3.033-8 7 0 2.024.978 3.825 2.499 5.085a3.478 3.478 0 01-.522 1.756.75.75 0 00.584 1.143 5.976 5.976 0 003.936-1.108c.487.082.99.124 1.503.124 4.31 0 8-3.033 8-7s-3.69-7-8-7z" clip-rule="evenodd" />
            </svg>
            <span data-comment-count-label>@Model.CommentCount @(Model.CommentCount == 1 ? "comment" : "comments")</span>
        </button>

        @if (Model.IsMine)
        {
            <span class="ml-auto flex items-center gap-2">
                <button type="button"
                        class="inline-flex min-h-9 items-center rounded-btn px-3 py-1.5 font-medium text-ink-muted transition-colors hover:bg-white/5 hover:text-ink"
                        hx-get="/reviews/@Model.ReviewId/edit"
                        hx-target="#@cardId"
                        hx-swap="outerHTML">
                    Edit
                </button>
                <button type="button"
                        class="inline-flex min-h-9 items-center rounded-btn px-3 py-1.5 font-medium text-danger/90 transition-colors hover:bg-danger/10 hover:text-danger"
                        hx-delete="/reviews/@Model.ReviewId"
                        hx-target="#@cardId"
                        hx-swap="outerHTML"
                        data-confirm-title="Delete review?"
                        data-confirm-message="This permanently removes your review and its likes and comments. This can't be undone."
                        data-confirm-action="Delete review"
                        data-confirm-tone="danger">
                    Delete
                </button>
            </span>
        }
    </footer>

    @* Comments (Milestone 3.2): a flat, lazy-loaded thread. Structure (mirrors _ReviewList): a PERSISTENT
       cards-only #comment-items list, with the load-more sentinel and the empty-state as SIBLINGS after it.
       The toggle innerHTML-loads _CommentList (which re-renders this same inner structure); the write form
       appends into #comment-items (beforeend) so a new comment never lands after the empty-state or below the
       sentinel (H3). The empty-state is CSS-driven (app.css) off classes site.ts sets — so it also comes back
       after the last comment is deleted (L10), with no OOB. tabindex="-1" is a focus fallback for site.ts. *@
    <section class="mt-4 border-t border-white/5 pt-4" aria-label="Comments on @Model.AuthorDisplayName's review">
        <div id="comment-thread-@Model.ReviewId" data-comment-thread data-review-id="@Model.ReviewId"
             tabindex="-1" class="comment-thread space-y-3"><div id="comment-items-@Model.ReviewId" class="comment-items space-y-3"></div><p class="comments-empty text-xs text-ink-subtle">No comments yet. Start the conversation.</p></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <partial name="_CommentWriteForm" model="new CommentWriteFormVm(Model.ReviewId)" />
        }
        else
        {
            @* M8: anonymous users see a subtle sign-in affordance where the write form would be. *@
            <p class="mt-3 text-xs text-ink-subtle">
                <a class="link" asp-controller="Account" asp-action="Login">Sign in</a> to comment.
            </p>
        }
    </section>
</article>
