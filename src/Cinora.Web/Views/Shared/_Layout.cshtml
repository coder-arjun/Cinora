@inject IAntiforgery Antiforgery
@inject IAssetManifest Assets
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject Microsoft.Extensions.Options.IOptions<Cinora.Infrastructure.Options.WebPushOptions> WebPush
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cinora — a premium social platform for movie and series reviews." />
    @* Open Graph / Twitter Card — the branded Cinora logo card shown as the rich link preview when a page (or the
       WhatsApp invite) is shared. The image is a same-origin static asset (/og-image.png, 1200×630); these meta
       tags carry no CSP weight. og:url/image are absolute (built from the current request) so they resolve on
       whatever host Cinora runs on. *@
    @{
        var ogBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var ogImage = $"{ogBase}/og-image.png";
        const string ogDescription = "Rate movies & series, follow reviews from your friends, build watchlists, and get recommendations picked for your taste.";
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cinora" />
    <meta property="og:title" content="Cinora — Social reviews for film &amp; series" />
    <meta property="og:description" content="@ogDescription" />
    <meta property="og:url" content="@ogBase" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:secure_url" content="@ogImage" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cinora — social reviews for film and series" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Cinora — Social reviews for film &amp; series" />
    <meta name="twitter:description" content="@ogDescription" />
    <meta name="twitter:image" content="@ogImage" />
    @* HTMX anti-forgery: Scripts/site.ts reads this token into the RequestVerificationToken header on
       every HTMX request. GetAndStoreTokens also sets the anti-forgery cookie, so any page can post. *@
    <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    @* HTMX config, read at init BEFORE htmx processes the page (mergeMetaConfig runs before insertIndicatorStyles).
       Disables HTMX's auto-injected inline <style> for its default request indicator: the strict `style-src 'self'`
       CSP (no 'unsafe-inline') blocks that inline <style>, surfacing a console CSP violation on every page. We use
       no hx-indicator anywhere, so turning the injection off removes the violation with zero visual change — and
       keeps the CSP byte-for-byte unchanged. The JSON content is parsed, never eval'd (CSP-safe); a meta is required
       because the deferred module bundle would set htmx.config too late. *@
    <meta name="htmx-config" content='{"includeIndicatorStyles": false}' />
    <title>@ViewData["Title"] · Cinora</title>
    @* Milestone 6.1 (ADR 0019) — PWA installability. The web app manifest is same-origin (governed by
       manifest-src → default-src 'self'), and theme-color matches the dark surface-0 @theme token so the
       install splash + browser chrome read as the luxury dark UI. No CSP change. *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#090b0f" />
    @* Tab icon: a crisp SVG favicon (the gold "C"+play mark) for capable browsers, with the PNG as the fallback. *@
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    @* iOS add-to-home-screen install metadata (iOS Safari ignores the web app manifest for these). *@
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    @* Standard PWA capability meta. The apple-prefixed form below is DEPRECATED (Chrome warns) but kept for older
       iOS Safari that reads only the apple-prefixed name; this standard name is what silences the deprecation. *@
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cinora" />
    @* PWA service-worker enable flag (FIX 2): rendered ONLY outside Development. Scripts/site.ts registers the
       cache-first SW when this is present and, in Development (flag absent), unregisters any stale SW instead —
       so hot edits to /dist/* are never masked. It leaks no environment name, only a boolean intent. *@
    @if (!Env.IsDevelopment())
    {
        <meta name="cinora-sw" content="enabled" />
    }
    <link rel="stylesheet" href="@Assets.Resolve("app.css")" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="flex min-h-dvh flex-col">
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-btn focus:bg-accent focus:px-4 focus:py-2 focus:font-semibold focus:text-on-accent">
        Skip to main content
    </a>

    @{
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        // Minimal, brand-only top bar on the focused auth/onboarding screens — set via ViewData["MinimalNav"] in
        // Login/Register/Tour. Keeps Discover/Search/Sign in/Register out of those pages' top bar.
        var minimalNav = ViewData["MinimalNav"] as bool? == true;
        const string navLink = "rounded-btn px-3 py-2 text-sm font-medium text-ink-muted transition-colors hover:bg-white/5 hover:text-ink";

        // Mobile side-drawer styling (matches the DailyPilot / ExpenseTracker drawer): sectioned icon rows with an
        // active state. NavActive highlights the row for the current route.
        var routeController = ViewContext.RouteData.Values["controller"]?.ToString();
        var routeAction = ViewContext.RouteData.Values["action"]?.ToString();
        bool NavActive(string controller, string? action = null) =>
            string.Equals(routeController, controller, StringComparison.OrdinalIgnoreCase)
            && (action is null || string.Equals(routeAction, action, StringComparison.OrdinalIgnoreCase));
        const string drawerRow = "flex items-center gap-3 rounded-btn px-2.5 py-2.5 text-sm font-medium text-ink-muted transition-colors hover:bg-white/5 hover:text-ink";
        const string drawerRowActive = "flex items-center gap-3 rounded-btn bg-accent/15 px-2.5 py-2.5 text-sm font-semibold text-ink";
        const string drawerIcon = "flex size-8 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-surface-2 text-ink-subtle";
        const string drawerLabel = "px-1.5 pb-1 pt-3 text-[0.68rem] font-bold uppercase tracking-[0.13em] text-ink-subtle";
    }
    <header x-data="navMenu" class="sticky top-0 z-40">
        @* The visible glass bar. The backdrop-blur lives HERE, not on <header>: a backdrop-filter creates a
           containing block for position:fixed descendants, which would otherwise trap the drawer's fixed panel +
           backdrop inside the ~64px-tall bar (panel renders header-height only, backdrop covers nothing). Keeping
           the filter off <header> lets the drawer below resolve its fixed positioning against the viewport. *@
        <div class="border-b border-white/10 bg-surface-0/70 backdrop-blur-glass">
        <nav aria-label="Primary" class="mx-auto flex w-full max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
            @* The logo is the primary entry to Discover (the language-based movie browse). *@
            <a asp-controller="Discovery" asp-action="Index" aria-label="Cinora — Discover"
               class="inline-flex items-center rounded-btn transition-opacity hover:opacity-80">
                <partial name="_Logo" />
            </a>

            @if (!minimalNav)
            {
                @* Desktop primary links (md and up); they collapse into the drawer below md. Discover is the logo;
                   Search comes last (after Watchlist), per the nav ordering. *@
                <div class="hidden items-center gap-1 md:flex">
                    @if (isAuthenticated)
                    {
                        <a asp-controller="Home" asp-action="Index" class="@navLink">The Reel</a>
                        <a asp-controller="Recommendations" asp-action="Index" class="@navLink">For You</a>
                        <a asp-controller="Friends" asp-action="Index" class="@navLink">Friends</a>
                        <a asp-controller="Watchlist" asp-action="Index" class="@navLink">Watchlist</a>
                        @* Search requires sign-in (Discover is login-only), so it only appears for authenticated users. *@
                        <a asp-controller="Discovery" asp-action="Search" aria-label="Search movies"
                           class="inline-flex items-center gap-1.5 @navLink">
                            <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                            </svg>
                            Search
                        </a>
                    }
                </div>

                @* Right cluster: always-visible actions (bell, avatar, primary CTA) plus the mobile hamburger. *@
                <div class="flex items-center gap-2 sm:gap-3">
                    @if (isAuthenticated)
                    {
                        @* In-app chat entry + unread badge (§9, seeded server-side). *@
                        <vc:chat-nav />
                        @* Milestone 3.5 — notification bell + live unread badge (seeded server-side, updated over SignalR). *@
                        <vc:notification-bell />
                        @* Account menu: the avatar dropdown groups the user's name, Settings and Log out together
                           (replaces the former loose Settings link + Log out button). Shown md+ (the drawer carries
                           the same actions below md). *@
                        <div class="hidden md:block">
                            <vc:current-user-avatar />
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="hidden sm:inline-flex @navLink">Sign in</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary text-sm">Register</a>
                    }

                    @* Hamburger — visible below md; toggles the drawer. CSP-safe bare-name Alpine bindings. *@
                    <button type="button" x-on:click="toggle" x-bind:aria-expanded="expanded"
                            aria-controls="mobile-nav" aria-label="Toggle navigation menu"
                            class="inline-flex items-center justify-center rounded-btn p-2 text-ink-muted transition-colors hover:bg-white/5 hover:text-ink md:hidden">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
                            <path d="M3 5h14M3 10h14M3 15h14" />
                        </svg>
                    </button>
                </div>
            }
        </nav>
        </div>

        @if (!minimalNav)
        {
            @* Mobile side-drawer (below md): a right-side slide-over with a backdrop scrim, a header (brand seal +
               close), and sectioned icon rows — the DailyPilot / ExpenseTracker drawer pattern. CSP-safe: the
               navMenu component (Scripts/components/navMenu.ts) slides the panel and fades the backdrop by toggling
               classes on the x-ref nodes; the markup uses only bare-name Alpine (x-ref, x-on:click, x-on:keydown). *@
            <div x-show="open" x-cloak x-on:click="close" aria-hidden="true"
                 x-transition:enter="transition-opacity ease-out duration-200"
                 x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
                 x-transition:leave="transition-opacity ease-in duration-150"
                 x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                 class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm md:hidden"></div>
            <div id="mobile-nav" x-show="open" x-cloak role="dialog" aria-modal="true" aria-label="Menu"
                 x-on:keydown.escape.window="close"
                 x-transition:enter="transition-transform ease-out duration-300 motion-reduce:transition-none"
                 x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
                 x-transition:leave="transition-transform ease-in duration-200 motion-reduce:transition-none"
                 x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
                 class="fixed inset-y-0 right-0 z-50 flex w-[min(86vw,20rem)] flex-col border-l border-white/10 bg-surface-1 shadow-elevated md:hidden">
                @* Header: brand seal + close. *@
                <div class="flex items-center justify-between border-b border-white/10 bg-surface-2/40 px-4 py-4">
                    <span class="inline-flex items-center gap-2.5">
                        <span class="flex size-9 items-center justify-center rounded-full border border-accent/60 text-accent">
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4" aria-hidden="true">
                                <path d="M13.2 5.6a5.5 5.5 0 1 0 0 8.8" stroke-linecap="round" />
                                <path d="M8.6 7.4l4 2.6-4 2.6z" fill="currentColor" stroke="none" />
                            </svg>
                        </span>
                        <span class="font-display text-lg font-semibold text-ink">Cinora</span>
                    </span>
                    <button type="button" x-on:click="close" aria-label="Close menu"
                            class="inline-flex size-9 items-center justify-center rounded-btn border border-white/10 text-ink-muted transition-colors hover:border-accent hover:text-accent">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-4" aria-hidden="true">
                            <path d="M5 5l10 10M15 5L5 15" />
                        </svg>
                    </button>
                </div>

                @* Body: sectioned icon rows with an active state. *@
                <nav aria-label="Menu links" class="flex flex-1 flex-col gap-0.5 overflow-y-auto p-3">
                    <p class="@drawerLabel">Browse</p>
                    @if (isAuthenticated)
                    {
                        <a asp-controller="Home" asp-action="Index" x-on:click="close"
                           class="@(NavActive("Home", "Index") ? drawerRowActive : drawerRow)">
                            <span class="@drawerIcon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                    <path d="M4 11l8-7 8 7" /><path d="M6 10v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9" /><path d="M10 20v-5h4v5" />
                                </svg>
                            </span>
                            The Reel
                        </a>
                        <a asp-controller="Recommendations" asp-action="Index" x-on:click="close"
                           class="@(NavActive("Recommendations") ? drawerRowActive : drawerRow)">
                            <span class="@drawerIcon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                    <path d="M12 3.5l2.6 5.27 5.82.846-4.21 4.104.994 5.797L12 16.77l-5.204 2.737.994-5.797-4.21-4.104 5.82-.846z" />
                                </svg>
                            </span>
                            For You
                        </a>
                        <a asp-controller="Friends" asp-action="Index" x-on:click="close"
                           class="@(NavActive("Friends") ? drawerRowActive : drawerRow)">
                            <span class="@drawerIcon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                    <circle cx="9" cy="8" r="3.2" /><path d="M3.5 20a5.5 5.5 0 0 1 11 0" /><path d="M16 5.4a3 3 0 0 1 0 5.9" /><path d="M17.6 20a5.5 5.5 0 0 0-3-4.9" />
                                </svg>
                            </span>
                            Friends
                        </a>
                        <a asp-controller="Chat" asp-action="Index" x-on:click="close"
                           class="@(NavActive("Chat") ? drawerRowActive : drawerRow)">
                            <span class="@drawerIcon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                    <path d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H9l-4 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" />
                                </svg>
                            </span>
                            Messages
                        </a>
                        <a asp-controller="Watchlist" asp-action="Index" x-on:click="close"
                           class="@(NavActive("Watchlist") ? drawerRowActive : drawerRow)">
                            <span class="@drawerIcon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                    <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z" />
                                </svg>
                            </span>
                            Watchlist
                        </a>
                        <a asp-controller="Discovery" asp-action="Search" x-on:click="close"
                           class="@(NavActive("Discovery", "Search") ? drawerRowActive : drawerRow)">
                            <span class="@drawerIcon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                    <circle cx="11" cy="11" r="6" /><path d="M20 20l-3.6-3.6" />
                                </svg>
                            </span>
                            Search
                        </a>
                        <p class="@drawerLabel">Account</p>
                        <a asp-controller="Settings" asp-action="EditProfile" x-on:click="close"
                           class="@(NavActive("Settings") ? drawerRowActive : drawerRow)">
                            <span class="@drawerIcon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                    <circle cx="12" cy="12" r="3.2" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.2 5.2l2.1 2.1M16.7 16.7l2.1 2.1M18.8 5.2l-2.1 2.1M7.3 16.7l-2.1 2.1" />
                                </svg>
                            </span>
                            Settings
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-1">
                            <button type="submit" class="@drawerRow w-full">
                                <span class="@drawerIcon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                        <path d="M14 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3" /><path d="M10 8l-4 4 4 4" /><path d="M6 12h11" />
                                    </svg>
                                </span>
                                Log out
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="@drawerLabel">Account</p>
                        <a asp-controller="Account" asp-action="Login" x-on:click="close" class="@drawerRow">
                            <span class="@drawerIcon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-[18px]" aria-hidden="true">
                                    <path d="M10 4H7a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h3" /><path d="M14 8l4 4-4 4" /><path d="M18 12H8" />
                                </svg>
                            </span>
                            Sign in
                        </a>
                        <a asp-controller="Account" asp-action="Register" x-on:click="close" class="btn btn-primary mt-2 w-full text-sm">
                            Create account
                        </a>
                    }
                </nav>
            </div>
        }
    </header>

    @* Dismissible push opt-in bar (mobile discoverability) — authed pages with Web Push configured; Scripts/site.ts
       reveals it only when push is supported and permission is still "default" (or shows an iOS install hint). *@
    @if (isAuthenticated && !minimalNav && WebPush.Value.IsConfigured)
    {
        <partial name="_PushOptIn" />
    }

    <main id="main-content" tabindex="-1" class="flex-1">
        @RenderBody()
    </main>

    <footer class="border-t border-white/10">
        <div class="mx-auto flex w-full max-w-6xl flex-col gap-1 px-4 py-6 text-sm text-ink-subtle sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <span>© @DateTime.UtcNow.Year Cinora</span>
            <span>Every film, reviewed.</span>
        </div>
    </footer>

    @* Milestone 3.5 — host for realtime notification toasts. A persistent polite live region: Scripts/site.ts
       appends toasts here (text set via textContent, XSS-safe) when a SignalR notification arrives. Empty and
       invisible until populated; styled fixed-position in app.css. *@
    <div id="toast-host" aria-live="polite"></div>

    @* Milestone 4.3 — shared polite status region for the watchlist control (§5.3). It lives OUTSIDE every
       _WatchlistControl (which swaps its own outerHTML) so it survives swaps; Scripts/site.ts writes a concise
       announcement here after a set/remove ("Marked as Watched", "Removed from watchlist"). Empty until then. *@
    <div id="watchlist-status" class="sr-only" role="status" aria-live="polite"></div>

    @* Milestone 5.4 — shared polite status region for the For-You dismiss control. It lives OUTSIDE every
       _RecommendationCard (whose <li> is removed on dismiss) so it survives the swap; Scripts/site.ts writes a
       concise "Dismissed {title}" (or the too-fast retry copy) here after a dismiss. Empty until then. *@
    <div id="recommendations-status" class="sr-only" role="status" aria-live="polite"></div>

    @* Milestone 4.3 — shared inline error for a failed watchlist WRITE (a 429/500 HTMX won't swap, so the
       control would otherwise change nothing with no feedback). One node serves every surface the control
       appears on; Scripts/site.ts unhides + fills it (role="alert" → announced) and clears it on the next
       successful swap. Hidden and out of the layout flow until then. NOT the polite region above. *@
    <div id="watchlist-error" role="alert" class="wl-alert hidden"></div>

    @* Milestone 6.5 (backlog 3.1) — the shared styled delete-confirmation dialog. Rendered once; the destructive
       actions across the app (delete review/comment, remove friend/avatar) carry data-confirm-* attributes that
       Scripts/site.ts intercepts on htmx:confirm to open this dialog IN PLACE OF the native confirm — gating the
       same hx-delete/hx-post + anti-forgery request without changing it. CSP-safe (@alpinejs/csp, no inline JS). *@
    <partial name="_ConfirmDialog" />

    <script type="module" src="@Assets.Resolve("site.js")"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
