@model CommentListVm
@{
    string? nextUrl = null;
    if (Model.HasMore && Model.NextCursor is { } cursor)
    {
        nextUrl = Url.Action("List", "Comments", new
        {
            id = Model.ReviewId,
            cursorCreatedAt = cursor.CreatedAtUtc.ToString("o", System.Globalization.CultureInfo.InvariantCulture),
            cursorId = cursor.Id,
        });
    }
}

@*
    Milestone 3.2 — the public comment thread (first page; partial, NO layout), oldest-first. innerHTML-loaded
    into the review's #comment-thread region, re-rendering the same inner structure as the _ReviewCard scaffold:
    a cards-only #comment-items list, then the load-more sentinel and the empty-state as SIBLINGS after it. The
    write form appends new comments into #comment-items (beforeend) — never after the sentinel/empty-state (H3).
    The empty-state is CSS-driven (app.css, off classes site.ts sets), so it also returns after the last comment
    is deleted (L10). The sentinel reuses the 2.4/3.1 keyset grammar (hx-trigger="revealed" / hx-swap="outerHTML"
    / terminal state) and carries the opaque (cursorCreatedAt, cursorId) cursor. Attribute-driven HTMX only —
    no hx-on, no inline JS — CSP-safe.
*@
<div id="comment-items-@Model.ReviewId" class="comment-items space-y-3">@foreach (var comment in Model.Items)
    {
        <partial name="_CommentCard" model="comment" />
    }</div>
@if (nextUrl is not null)
{
    <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" aria-hidden="true">
        <div class="skeleton-shimmer h-12 rounded-card"></div>
    </div>
}
<p class="comments-empty text-xs text-ink-subtle">No comments yet. Start the conversation.</p>
