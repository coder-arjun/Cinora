@model LikeButtonVm
@{
    var likeUrl = $"/reviews/{Model.ReviewId}/like";
    var likesWord = Model.LikeCount == 1 ? "like" : "likes";
    // M4: fold the count INTO the accessible name (the aria-label used to override the visible count, so SR
    // users never heard it). aria-pressed still conveys the toggle state; the heart stays aria-hidden.
    var label = Model.LikedByMe
        ? $"Remove your like, {Model.LikeCount} {likesWord}"
        : $"Like this review, {Model.LikeCount} {likesWord}";
}

@*
    Milestone 3.2 — the like toggle. It swaps ITSELF (hx-target="this", outerHTML) with the re-rendered
    partial the like/unlike endpoint returns, so the count + pressed state update in place. Liked → hx-delete
    (unlike); not liked → hx-post (like). A STABLE id ("like-btn-{ReviewId}") lets HTMX restore focus to the
    re-rendered button in place (WCAG 2.4.3), and data-like-button / data-like-count let Scripts/site.ts
    announce "Liked, N likes" / "Like removed, N likes" without the review handler misfiring. aria-pressed
    conveys state to assistive tech. Attribute-driven HTMX only — no inline JS, no hx-on — and the anti-forgery
    token rides the RequestVerificationToken header site.ts attaches, so the strict CSP is untouched.
*@
@if (Model.LikedByMe)
{
    <button type="button" id="like-btn-@Model.ReviewId" data-like-button data-like-count="@Model.LikeCount"
            aria-pressed="true" aria-label="@label"
            class="inline-flex min-h-9 items-center gap-1.5 rounded-btn px-3 py-1.5 text-xs font-medium text-accent transition-colors hover:bg-accent/10"
            hx-delete="@likeUrl" hx-target="this" hx-swap="outerHTML">
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path d="M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 01-1.162-.682 22.045 22.045 0 01-2.582-1.9C4.045 12.733 2 10.352 2 7.5a4.5 4.5 0 018-2.828A4.5 4.5 0 0118 7.5c0 2.852-2.044 5.233-3.885 6.82a22.049 22.049 0 01-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 01-.69.001l-.002-.001z" />
        </svg>
        <span>@Model.LikeCount</span>
    </button>
}
else
{
    <button type="button" id="like-btn-@Model.ReviewId" data-like-button data-like-count="@Model.LikeCount"
            aria-pressed="false" aria-label="@label"
            class="inline-flex min-h-9 items-center gap-1.5 rounded-btn px-3 py-1.5 text-xs font-medium text-ink-muted transition-colors hover:bg-white/5 hover:text-ink"
            hx-post="@likeUrl" hx-target="this" hx-swap="outerHTML">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 01-1.162-.682 22.045 22.045 0 01-2.582-1.9C4.045 12.733 2 10.352 2 7.5a4.5 4.5 0 018-2.828A4.5 4.5 0 0118 7.5c0 2.852-2.044 5.233-3.885 6.82a22.049 22.049 0 01-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 01-.69.001l-.002-.001z" />
        </svg>
        <span>@Model.LikeCount</span>
    </button>
}
