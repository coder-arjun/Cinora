@model ReviewWriteFormVm

@*
    Milestone 3.1 — the "write your review" form (authenticated users, no existing review). It uses the MVC
    form tag helper (asp-controller/asp-action) so a hidden __RequestVerificationToken is injected — that
    satisfies both the progressive-enhancement no-JS POST (which redirects back to the title) AND the HTMX
    path, since hx-post includes the form fields. Under JS, HTMX swaps the returned _ReviewCard into the
    #my-review region. No inline JS; the strict CSP is untouched.
*@
<form class="card-glass space-y-4 p-5 sm:p-6"
      asp-controller="Reviews" asp-action="Create" method="post"
      hx-post="/reviews"
      hx-target="#my-review"
      hx-swap="innerHTML">
    <input type="hidden" name="TmdbId" value="@Model.TmdbId" />
    <input type="hidden" name="Media" value="@Model.Media" />

    <h3 class="font-display text-lg text-ink">Write your review</h3>

    @* No-JS 400 path: a failed POST re-renders this form with ModelState errors. "All" surfaces both model-
       and field-level messages here (ReviewWriteFormVm carries no Rating/Body property to bind asp-validation-for
       to; the JS path shows failures inline via #review-error). *@
    <div asp-validation-summary="All" class="text-sm"></div>

    <div>
        <label class="label" for="new-review-rating">Your rating (1&ndash;10)</label>
        @* Rating input styled to echo the card's gold-star N/10 pill: a labelled, keyboard-operable numeric
           field (native ↑/↓ stepping) with a star affix and a "/10" suffix — not a mouse-only star widget. *@
        <div class="relative max-w-[10rem]">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center ps-3 text-accent" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 .5l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                </svg>
            </span>
            <input class="input ps-9 pe-11 font-semibold" id="new-review-rating" type="number" name="Rating"
                   min="1" max="10" step="1" inputmode="numeric" placeholder="8" required />
            <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pe-3 text-sm text-ink-muted" aria-hidden="true">/10</span>
        </div>
    </div>
    <div>
        <label class="label" for="new-review-body">Your review</label>
        <textarea class="input" id="new-review-body" name="Body" rows="4"
                  maxlength="@Cinora.Domain.Entities.Review.BodyMaxLength"
                  placeholder="Share what you thought&hellip;" required></textarea>
    </div>

    <button type="submit" class="btn btn-primary text-sm">Post review</button>
</form>
