@model UserSearchVm
@{
    var match = Model.Match;
}

@*
    Task B2.3 — the Find-people search result (GET /friends/search), swapped into #user-search-result inside
    the /friends hub's "Find people" section (an aria-live="polite" wrapper owns the region — see
    Views/Friends/Index.cshtml, Task B3.2). Search is exact-match only (§4): a no-match and a blocked user are
    indistinguishable (§14), so both render the SAME calm empty state — never an error, never a hint that a
    block occurred.

    A match renders as a first-class person-card row using the SAME grammar as _FriendCard / _BlockedUserCard
    (avatar + name link + trailing control) so it reads as part of the same list system, not a bolted-on
    variant. The trailing control is switched on the viewer's relationship, reusing _ProfileFriendControl's
    exact badge/button classes for that same reason. The "Add friend" form omits hx-target so HTMX swaps ONLY
    the form (outerHTML) with the returned _FriendActionResult status line — the avatar/name stay put, mirroring
    how _ProfileFriendControl's own default arm resolves after a send. DisplayName is user content — always
    Razor output-encoded (@@), never Html.Raw.
*@
@if (match is null)
{
    <p role="status" class="rounded-btn bg-surface-2/60 px-3 py-2 text-sm text-ink-subtle">
        No user found. Try their exact username or email.
    </p>
}
else
{
    <article class="flex items-center gap-3 rounded-card border border-white/5 bg-surface-1/40 px-4 py-3">
        <partial name="_Avatar" model="new AvatarViewModel(match.DisplayName, match.AvatarFileKey, AvatarSize.Medium, Decorative: true)" />

        <div class="min-w-0 flex-1">
            <a asp-controller="Profiles" asp-action="Profile" asp-route-id="@match.UserId" title="@match.DisplayName"
               class="block truncate text-sm font-semibold text-ink transition-colors hover:text-accent">@match.DisplayName</a>
        </div>

        @switch (match.Relationship)
        {
            case ProfileRelationship.Friend:
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-pill border border-white/10 bg-surface-2/60 px-3 py-1.5 text-sm font-medium text-ink">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-accent" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 011.4-1.4l2.3 2.29 6.3-6.29a1 1 0 011.4 0z" clip-rule="evenodd" />
                    </svg>
                    Friends
                </span>
                break;

            case ProfileRelationship.RequestOutgoing:
                <span class="inline-flex shrink-0 items-center rounded-pill border border-white/10 bg-surface-2/60 px-3 py-1.5 text-sm font-medium text-ink-subtle">
                    Requested
                </span>
                break;

            case ProfileRelationship.RequestIncoming:
                <span class="shrink-0 text-sm text-ink-muted">Respond in your requests</span>
                break;

            default:
                <form asp-controller="Friends" asp-action="Send" method="post"
                      hx-post="@Url.Action("Send", "Friends")"
                      hx-swap="outerHTML"
                      class="shrink-0">
                    <input type="hidden" name="AddresseeUserId" value="@match.UserId" />
                    <button type="submit" class="btn btn-primary text-sm">Add friend</button>
                </form>
                break;
        }
    </article>
}
