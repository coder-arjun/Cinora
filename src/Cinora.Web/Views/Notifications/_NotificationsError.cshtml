@model NotificationsErrorVm

@*
    Milestone 3.5 — a lazy inbox page read's FAILURE state (graceful degradation, mirrors _FeedError). Returned
    with HTTP 200 (NOT a 500) so HTMX swaps it in place of the shimmering load-more skeleton — HTMX never swaps a
    non-2xx response. aria-busy="false" so the region stops reporting itself busy (WCAG 4.1.2). The Retry control
    re-fires the SAME lazy load (the failing hx-get echoed into Model.RetryUrl). Attribute-driven HTMX only — no
    inline JS, no hx-on — so the strict `script-src 'self'` CSP is never touched.
*@
<li data-notification-error role="alert" aria-live="polite" aria-busy="false"
    class="my-2 flex flex-col items-start gap-4 rounded-card border border-white/10 bg-surface-1/60 px-5 py-6 backdrop-blur-glass sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-start gap-3">
        <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-accent" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.515 2.625H3.72c-1.345 0-2.188-1.458-1.515-2.625L8.485 2.495zM10 6a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 6zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <div>
            <p class="text-sm font-medium text-ink">Couldn&#39;t load more notifications.</p>
            <p class="mt-0.5 text-sm text-ink-muted">Something went wrong loading the next page.</p>
        </div>
    </div>

    <button type="button"
            hx-get="@Model.RetryUrl"
            hx-target="closest [data-notification-error]"
            hx-swap="outerHTML"
            class="btn btn-ghost shrink-0 text-sm">
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 01-9.201 2.466l-.312-.311h1.633a.75.75 0 000-1.5H3.669a.75.75 0 00-.75.75v3.762a.75.75 0 001.5 0v-1.898l.296.297a7 7 0 0011.712-3.138.75.75 0 00-1.449-.39zm1.23-3.723a.75.75 0 00.219-.53V3.409a.75.75 0 00-1.5 0v1.898l-.296-.297A7 7 0 003.489 8.15a.75.75 0 101.449.39 5.5 5.5 0 019.201-2.466l.312.311H12.82a.75.75 0 000 1.5h3.762a.75.75 0 00.53-.219z" clip-rule="evenodd" />
        </svg>
        Retry
    </button>
</li>
