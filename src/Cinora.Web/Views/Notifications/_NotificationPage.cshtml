@model NotificationListVm
@{
    var loaded = Model.Items.Count;
    var moreAnnounce = $"{loaded} more {(loaded == 1 ? "notification" : "notifications")} loaded";

    string? nextUrl = null;
    if (Model.HasMore && Model.NextCursor is { } cursor)
    {
        nextUrl = Url.Action("Feed", "Notifications", new
        {
            cursorCreatedAt = cursor.CreatedAtUtc.ToString("o", System.Globalization.CultureInfo.InvariantCulture),
            cursorId = cursor.Id,
        });
    }
}

@*
    Milestone 3.5 — the inbox load-more fragment (a cursor request). Returned by the sentinel's hx-get and swapped
    via outerHTML in place of that sentinel <li>, so these <li> cards append to the #notification-items <ul>. Iff
    HasMore, a FRESH sentinel <li> re-arms the chain toward the next keyset page; otherwise a quiet terminal <li>
    ends it. Each sentinel/terminal carries a data-notification-announce string Scripts/site.ts may copy into the
    polite status node. Attribute-only HTMX — no hx-on, no inline JS — so the strict CSP is untouched.
*@
@foreach (var item in Model.Items)
{
    <partial name="_NotificationItem" model="item" />
}

@if (nextUrl is not null)
{
    <li hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" aria-hidden="true" data-notification-announce="@moreAnnounce">
        <div class="skeleton-shimmer h-20 rounded-card"></div>
    </li>
}
else if (loaded > 0)
{
    <li class="py-4 text-center text-sm text-ink-subtle" data-notification-announce="You're all caught up">
        You&rsquo;re all caught up.
    </li>
}
