@model ProfileSettingsViewModel
@{
    ViewData["Title"] = "Settings";
    var maxMb = Math.Max(1, Model.MaxUploadBytes / 1_000_000);
}

@*
    Milestone 4.2 — the owner-only settings page (§4.2, §11), elevated to the luxury dark / glassmorphism design
    system in Step C.

    - The current avatar renders through the shared _Avatar seam (real <img> via the time-limited token URL, or the
      monogram fallback), Large + LABELLED (it stands alone in this card, no adjacent visible name). It lives inside
      #current-avatar so the upload/remove HTMX actions swap only the avatar, returning the re-rendered _Avatar.
    - The avatar upload is multipart/form-data; the MVC form tag helper emits the anti-forgery token (validated by
      the global AutoValidateAntiforgeryToken), and site.ts also attaches the token header to the HTMX POST. The
      server is authoritative on type/size (magic-byte gate) — the accept/hint here is a convenience only.
    - The display-name + privacy form is the reusable _ProfileForm partial.

    A11y (Step C, §11): #settings-status (persistent polite node) and #settings-error (persistent role="alert")
    live OUTSIDE the two swap targets (#current-avatar, #profile-form) so they survive swaps and reliably announce.
    site.ts (the region-scoped Phase-3 pattern) announces a concise result there after each settings swap, restores
    focus when a swap destroys the focused control, and — the key Step-C gap — renders a concise inline alert into
    #settings-error on a non-2xx HTMX response (a bad-type/oversize avatar or an invalid profile update returns a
    400 ProblemDetails that HTMX will NOT swap), instead of the user seeing nothing / a raw ProblemDetails page. No
    CSP widening: same-origin multipart POST (connect-src 'self'), same-origin avatar <img> (img-src 'self').
*@
<section class="mx-auto w-full max-w-2xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-8 animate-rise-in">
        <h1 class="font-display text-3xl text-ink sm:text-4xl">Settings</h1>
        <p class="mt-2 text-sm text-ink-subtle">Manage your profile, avatar, and privacy.</p>
    </header>

    @* Persistent polite node: site.ts copies a concise result here after a settings swap ("Avatar updated",
       "Avatar removed", "Profile saved") — reliable SR feedback a freshly-inserted role="status" would not give. *@
    <span id="settings-status" class="sr-only" role="status" aria-live="polite"></span>

    @* The inline error surface (Step C). Hidden until site.ts fills it on a non-2xx HTMX response; role="alert"
       so the message is announced. Kept OUTSIDE both swap targets so a swap never destroys it. *@
    <div id="settings-error" role="alert"
         class="mb-6 hidden rounded-btn border border-danger/40 bg-danger/10 px-4 py-3 text-sm text-ink"></div>

    <div class="card-glass p-6 sm:p-8">
        <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
                <h2 class="font-display text-xl text-ink">Avatar</h2>
                <p class="mt-1 text-sm text-ink-subtle">A photo helps friends recognise you across Cinora.</p>
            </div>
        </div>

        <div class="mt-6 flex flex-col items-start gap-6 sm:flex-row sm:items-center">
            @* tabindex="-1": site.ts can move focus here after an avatar swap if the focused control was destroyed. *@
            <div id="current-avatar" tabindex="-1" class="rounded-pill outline-none">
                <partial name="_Avatar" model="@(new AvatarViewModel(Model.DisplayName, Model.AvatarFileKey, AvatarSize.Large, Eager: true))" />
            </div>

            <div class="min-w-0 flex-1 space-y-4">
                <form asp-controller="Settings" asp-action="UploadAvatar" method="post"
                      enctype="multipart/form-data"
                      hx-post="/settings/profile/avatar" hx-target="#current-avatar" hx-swap="innerHTML"
                      hx-encoding="multipart/form-data"
                      class="space-y-3">
                    @* Visible <label>, associated to the file input, describing the accepted types + max size. *@
                    <label for="avatar-file" class="label">
                        Upload a photo
                        <span class="font-normal text-ink-subtle">&mdash; JPEG, PNG or WebP, up to @maxMb MB</span>
                    </label>
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                        <input id="avatar-file" name="file" type="file"
                               accept="image/jpeg,image/png,image/webp" required
                               class="block w-full cursor-pointer rounded-btn text-sm text-ink-muted file:mr-3 file:cursor-pointer file:rounded-btn file:border-0 file:bg-accent/15 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-accent file:transition-colors hover:file:bg-accent/25" />
                        <button type="submit" class="btn btn-primary shrink-0 text-sm">Upload</button>
                    </div>
                </form>

                @if (Model.AvatarFileKey is not null)
                {
                    <button type="button"
                            class="inline-flex min-h-9 items-center rounded-btn px-3 py-1.5 text-xs font-medium text-danger/90 transition-colors hover:bg-danger/10 hover:text-danger"
                            hx-delete="/settings/profile/avatar"
                            hx-target="#current-avatar" hx-swap="innerHTML"
                            data-confirm-title="Remove photo?"
                            data-confirm-message="Your avatar will go back to the default monogram. You can upload a new photo any time."
                            data-confirm-action="Remove"
                            data-confirm-tone="danger">
                        Remove photo
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="card-glass mt-6 p-6 sm:p-8">
        <h2 class="font-display text-xl text-ink">Profile</h2>
        <p class="mt-1 text-sm text-ink-subtle">Your name and who can see your activity.</p>
        @* tabindex="-1": site.ts restores focus here after the form self-swaps (the Save button is destroyed). *@
        <div id="profile-form" tabindex="-1" class="mt-6 outline-none">
            <partial name="_ProfileForm" model="Model" />
        </div>
    </div>

    @* Milestone 6.3 (ADR 0020) — notification preferences moved to their own canonical surface
       (/settings/notifications): the device push opt-in AND the per-type push toggles now live there together. This
       card is just a signpost. Same-origin link — no CSP impact. *@
    <div class="card-glass mt-6 p-6 sm:p-8">
        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
            <div class="min-w-0">
                <h2 class="font-display text-xl text-ink">Notifications</h2>
                <p class="mt-1 text-sm text-ink-subtle">
                    In-app notifications always arrive. Manage push on your devices and choose what pushes.
                </p>
            </div>
            <a asp-controller="Settings" asp-action="Notifications" class="btn btn-ghost shrink-0 text-sm">
                Notification settings
            </a>
        </div>
    </div>
</section>
