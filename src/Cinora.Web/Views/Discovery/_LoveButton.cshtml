@using Cinora.Domain.Enums
@model Cinora.Web.ViewModels.Discovery.LoveButtonVm
@{
    var mediaToken = Model.Media.ToString().ToLowerInvariant();
    var label = Model.Liked ? "Loved — tap to remove" : "Love this title";
    var sizeClass = Model.OnDetails ? "love-btn--lg" : null;
}
@*
    The title-level "love" button (§ movie likes). Toggles via POST /discover/title/{media}/{tmdbId}/like and
    swaps ITSELF (hx-target="this") so the same title can appear in several rails without duplicate ids. The
    filled heart + pop animation are CSS (.love-btn / @keyframes love-pop in app.css) — reduced-motion safe. The
    heart path is decorative; the button carries the accessible name + aria-pressed. Anonymous → a read-only count.
*@
@if (Model.IsAuthenticated)
{
    <button type="button"
            class="love-btn @(Model.Liked ? "is-liked" : null) @sizeClass"
            aria-pressed="@(Model.Liked ? "true" : "false")" aria-label="@label" title="@label"
            hx-post="@($"/discover/title/{mediaToken}/{Model.TmdbId}/like")"
            hx-target="this" hx-swap="outerHTML">
        <svg class="love-heart" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 21s-6.716-4.35-9.333-8.028C.9 10.28 1.6 6.9 4.4 5.7c1.98-.848 4.06-.2 5.2 1.3l.4.52.4-.52c1.14-1.5 3.22-2.148 5.2-1.3 2.8 1.2 3.5 4.58 1.733 7.272C18.716 16.65 12 21 12 21z" />
        </svg>
        <span class="love-count">@Model.Count</span>
    </button>
}
else
{
    <span class="love-btn love-btn--static @sizeClass" aria-label="@Model.Count loves">
        <svg class="love-heart" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 21s-6.716-4.35-9.333-8.028C.9 10.28 1.6 6.9 4.4 5.7c1.98-.848 4.06-.2 5.2 1.3l.4.52.4-.52c1.14-1.5 3.22-2.148 5.2-1.3 2.8 1.2 3.5 4.58 1.733 7.272C18.716 16.65 12 21 12 21z" />
        </svg>
        <span class="love-count">@Model.Count</span>
    </span>
}
