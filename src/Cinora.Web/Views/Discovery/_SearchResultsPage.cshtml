@model SearchResultsViewModel
@{
    var results = Model.Results;
    var nextPage = results.Page + 1;
    var loaded = results.Items.Count;
    // Concise strings for the polite #search-status node (copied there by site.ts after the swap).
    var moreAnnounce = $"{loaded} more results loaded";
    var endAnnounce = loaded > 0 ? $"{loaded} more results loaded, end of results" : "End of results";
}

@*
    Milestone 2.4 / 4.3 — the load-more fragment (page > 1). Returned by the sentinel's hx-get and swapped via
    outerHTML in place of that sentinel, so these <li> cards append to the results <ul>. Iff HasMore, a FRESH
    sentinel <li> re-arms the chain toward the next page; otherwise a quiet, full-width terminal marker ends
    it (no sentinel → the chain stops). Attribute-only HTMX — no hx-on, no inline JS. Each card carries its
    _WatchlistControl driven by the batch status map (ADR 0014).
*@
@foreach (var card in results.Items)
{
    var status = Model.Statuses.TryGetValue((card.TmdbId, card.MediaType), out var s) ? s : (WatchlistStatus?)null;
    var control = new WatchlistControlVm(card.TmdbId, card.MediaType, status, Model.IsAuthenticated);
    var likeState = Model.Likes.TryGetValue((card.TmdbId, card.MediaType), out var lk) ? lk : null;
    var love = new LoveButtonVm(card.TmdbId, card.MediaType, likeState?.Liked ?? false, likeState?.Count ?? 0, Model.IsAuthenticated);
    <li>
        <div class="relative">
            <partial name="_TitleCard" model="card" />
            <div class="absolute left-2 top-2 z-10">
                <partial name="_WatchlistControl" model="control" />
            </div>
            <div class="absolute right-2 top-2 z-10">
                <partial name="_LoveButton" model="love" />
            </div>
        </div>
    </li>
}

@if (results.HasMore)
{
    @* Decorative skeleton (aria-hidden) but carries the concise announce string on its data attribute for
       site.ts to read on this swap. *@
    <li hx-get="@Url.Action("SearchResults", "Discovery", new { q = results.Query, media = results.Media, page = nextPage })"
        hx-trigger="revealed"
        hx-swap="outerHTML"
        aria-hidden="true"
        data-search-announce="@moreAnnounce">
        <div class="skeleton-shimmer aspect-[2/3] rounded-card"></div>
        <div class="skeleton-shimmer mt-3 h-3.5 w-3/4 rounded-pill"></div>
        <div class="skeleton-shimmer mt-2 h-3 w-1/3 rounded-pill"></div>
    </li>
}
else
{
    @* Terminal marker — readable (no aria-hidden) so a screen reader encounters it in the reading order, and
       it also drives the polite #search-status announcement via data-search-announce. *@
    <li class="col-span-full py-6 text-center text-sm text-ink-subtle" data-search-announce="@endAnnounce">
        You&rsquo;ve reached the end.
    </li>
}
