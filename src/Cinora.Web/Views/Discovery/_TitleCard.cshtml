@model TitleCardVm
@{
    var year = Model.ReleaseYear;
    var hasRating = Model.VoteAverage > 0;
    var rating = Model.VoteAverage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);

    // One accessible name for the whole card link: title, year, and rating (out of 10) when present.
    var accessibleName = Model.Title
        + (year is { } y ? $" ({y})" : string.Empty)
        + (hasRating ? $", rated {rating} out of 10" : string.Empty);
    var detailsHref = $"/discover/title/{Model.MediaType.ToString().ToLowerInvariant()}/{Model.TmdbId}";
}

@*
    Milestone 2.3 — a single 2:3 poster card linking to the Details route (landing in 2.5). The fixed
    aspect frame reserves space so the lazy poster cannot cause layout shift (CLS). The Details href pattern
    /discover/title/{media}/{tmdbId} is FIXED here; 2.5 must honor it. Hover/focus lift, art zoom and the
    glass rating badge are driven by .poster-card in app.css (transform/opacity only, reduced-motion safe).
    The whole card is one link with an explicit accessible name; the rating badge is decorative because the
    rating is already in that name.
*@
<a href="@detailsHref" class="poster-card" aria-label="@accessibleName">
    <div class="poster-frame aspect-[2/3]">
        <img asp-tmdb-poster="@Model.PosterPath" asp-tmdb-size="W342" alt="@Model.Title"
             class="poster-img" />

        @* Cinematic base vignette for depth — decorative only, in the page surface tone. *@
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/4 bg-gradient-to-t from-surface-0/60 to-transparent"
             aria-hidden="true"></div>

        @if (hasRating)
        {
            <span class="pointer-events-none absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-pill border border-white/15 bg-surface-0/70 px-2 py-0.5 text-xs font-semibold text-ink backdrop-blur-glass"
                  aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3 text-accent" aria-hidden="true">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 .5l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                </svg>
                @rating
            </span>
        }
    </div>

    <div class="mt-3">
        <h3 class="truncate text-sm font-medium text-ink" title="@Model.Title">@Model.Title</h3>
        @if (year is { } yr)
        {
            <p class="mt-0.5 text-xs text-ink-subtle">@yr</p>
        }
    </div>
</a>
