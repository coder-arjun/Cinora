@model HomeFeedViewModel
@using Cinora.Web.Infrastructure
@{
    ViewData["Title"] = "Discover";
    var selectedLanguage = Model.Language ?? LanguageOptions.GlobalCode;
}

@*
    Milestone 2.3 — Home / discovery shell. STATIC presentation config (no ISender, no TMDB, no DB): one
    heading + one lazy-loading container per rail slot. Each container HTMX-GETs its cards from
    /discover/rail on load, so the three TMDB calls run in parallel and never block first paint, and each
    rail caches independently. Premium styling (glass eyebrow, snap-scroll rails, shimmer skeletons) is
    layered on with the design tokens in Styles/app.css. The hx-* wiring, the /discover/rail URLs and the
    data-rail-skeleton marker are the tested 2.3 contract and are preserved verbatim.
*@
<section class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <header class="animate-rise-in mb-10 max-w-2xl sm:mb-12">
        <p class="inline-flex items-center gap-2 rounded-pill border border-white/10 bg-surface-1/60 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-accent backdrop-blur-glass">
            Browse
        </p>
        <h1 class="mt-5 font-display text-display font-semibold text-ink">Discover</h1>
        <p class="mt-4 text-lg text-ink-muted">
            Trending, popular, and top-rated films.
        </p>

        @* Language filter: pick a language to see films ORIGINALLY in it (regional cinema); "Global" = worldwide.
           CSP-safe Alpine (bare-name x-on:change="navigate") reloads /discover?language=<code>; the no-JS Apply
           button submits the same GET form. Same-origin navigation — no CSP impact. *@
        <form method="get" asp-controller="Discovery" asp-action="Index" x-data="languageSelect"
              class="mt-6 flex flex-wrap items-end gap-3">
            <div>
                <label for="language-select" class="label mb-1 block text-sm">Language</label>
                <select id="language-select" name="language" x-on:change="navigate" class="input w-56 max-w-full">
                    @foreach (var option in LanguageOptions.All)
                    {
                        <option value="@option.Code" selected="@(option.Code == selectedLanguage ? "selected" : null)">@option.Name</option>
                    }
                </select>
            </div>
            <noscript>
                <button type="submit" class="btn btn-ghost text-sm">Apply</button>
            </noscript>
        </form>
    </header>

    <div class="space-y-12 sm:space-y-14" data-reveal-group>
        @* Most Loved — the community's most-loved movies (feature #4), sourced from Cinora's own like data.
           Lazy-loaded like every other rail from /discover/rail/loved; an app with no loves yet shows the
           _Rail quiet empty state. Sits first so the social signal leads the page. *@
        <section aria-labelledby="rail-heading-most-loved">
            <h2 id="rail-heading-most-loved" class="mb-1 flex items-center gap-2 font-display text-2xl text-ink sm:text-3xl">
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-[#f43f5e]" aria-hidden="true">
                    <path d="M12 21s-7.2-4.35-9.6-8.55C.9 9.6 2.1 6 5.4 6c1.98 0 3.42 1.14 4.2 2.34C10.38 7.14 11.82 6 13.8 6c3.3 0 4.5 3.6 3 6.45C19.2 16.65 12 21 12 21z" />
                </svg>
                Most Loved
            </h2>
            <div hx-get="@Url.Action("MostLovedRail", "Discovery")"
                 hx-trigger="load"
                 hx-swap="outerHTML"
                 aria-busy="true">
                <div class="flex gap-4 overflow-hidden py-5" data-rail-skeleton aria-hidden="true">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="w-32 shrink-0 sm:w-40 lg:w-44">
                            <div class="skeleton-shimmer aspect-[2/3] rounded-card"></div>
                            <div class="skeleton-shimmer mt-3 h-3.5 w-3/4 rounded-pill"></div>
                            <div class="skeleton-shimmer mt-2 h-3 w-1/3 rounded-pill"></div>
                        </div>
                    }
                </div>
            </div>
        </section>

        @foreach (var slot in Model.Rails)
        {
            var railId = $"rail-heading-{slot.Media}-{slot.Kind}";
            <section aria-labelledby="@railId">
                <h2 id="@railId" class="mb-1 font-display text-2xl text-ink sm:text-3xl">@slot.Heading</h2>

                @*
                    Lazy per-rail load: HTMX GETs the _Rail partial on load and swaps it in place of the
                    skeleton. The hx-get is same-origin (/discover/rail), so the strict connect-src 'self'
                    CSP already allows it — only img-src widens for TMDB posters (§10.6). hx-swap="outerHTML"
                    (not innerHTML) so the loaded partial REPLACES this whole container — the partial's root
                    then carries aria-busy="false", which clears this busy state instead of leaving a stale
                    aria-busy="true" on a now-loaded region (WCAG 4.1.2). A rail-load failure comes back as
                    the _RailError retry partial with HTTP 200 (HTMX won't swap a non-2xx), never an infinite
                    shimmer.
                *@
                <div hx-get="@Url.Action("Rail", "Discovery", new { kind = slot.Kind, media = slot.Media, language = Model.Language })"
                     hx-trigger="load"
                     hx-swap="outerHTML"
                     aria-busy="true">
                    @* Shimmer skeleton until the rail streams in; mirrors the real card (poster + title +
                       year lines) so nothing shifts when the cards swap in. Purely decorative → aria-hidden. *@
                    <div class="flex gap-4 overflow-hidden py-5" data-rail-skeleton aria-hidden="true">
                        @for (var i = 0; i < 6; i++)
                        {
                            <div class="w-32 shrink-0 sm:w-40 lg:w-44">
                                <div class="skeleton-shimmer aspect-[2/3] rounded-card"></div>
                                <div class="skeleton-shimmer mt-3 h-3.5 w-3/4 rounded-pill"></div>
                                <div class="skeleton-shimmer mt-2 h-3 w-1/3 rounded-pill"></div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    </div>
</section>
