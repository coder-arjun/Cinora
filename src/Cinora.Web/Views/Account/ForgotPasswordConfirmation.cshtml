@{
    ViewData["Title"] = "Check your email";
    ViewData["MinimalNav"] = true;
}

<section class="mx-auto flex w-full max-w-md flex-col px-4 py-16 sm:py-24">
    <div class="card-glass animate-rise-in p-6 text-center sm:p-8">
        <div class="mx-auto flex size-14 items-center justify-center rounded-full border border-accent/30 bg-accent/10 text-accent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-7 w-7" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5 12 13l9-5.5M4.5 5.25h15A1.5 1.5 0 0 1 21 6.75v10.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.25V6.75a1.5 1.5 0 0 1 1.5-1.5Z" />
            </svg>
        </div>
        <h1 class="mt-5 font-display text-3xl text-ink">Check your email</h1>
        <p class="mt-3 text-sm text-ink-muted">
            If an account matches that address, we've sent a link to reset your password. It can take a minute to
            arrive — remember to check your spam folder.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-8 w-full">Back to sign in</a>
    </div>
</section>
