@{
    ViewData["Title"] = "Password reset";
    ViewData["MinimalNav"] = true;
}

<section class="mx-auto flex w-full max-w-md flex-col px-4 py-16 sm:py-24">
    <div class="card-glass animate-rise-in p-6 text-center sm:p-8">
        <div class="mx-auto flex size-14 items-center justify-center rounded-full border border-accent/30 bg-accent/10 text-accent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
            </svg>
        </div>
        <h1 class="mt-5 font-display text-3xl text-ink">Password updated</h1>
        <p class="mt-3 text-sm text-ink-muted">
            Your password has been changed. You can now sign in with your new password.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-8 w-full">Sign in</a>
    </div>
</section>
