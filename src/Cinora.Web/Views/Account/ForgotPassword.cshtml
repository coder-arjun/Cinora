@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    ViewData["Aurora"] = true;
    ViewData["MinimalNav"] = true;
}

<section class="mx-auto flex w-full max-w-md flex-col px-4 py-16 sm:py-24">
    <div class="card-glass animate-rise-in p-6 sm:p-8" data-spotlight>
        <h1 class="font-display text-3xl text-ink">Forgot your password?</h1>
        <p class="mt-2 text-sm text-ink-muted">Enter your email and we'll send you a link to reset it.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="mt-8 space-y-5">
            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <div>
                <label asp-for="Email" class="label"></label>
                <input asp-for="Email" type="email" autocomplete="email" class="input"
                       placeholder="you@example.com"
                       aria-describedby="Email-error"
                       aria-invalid="@(ViewData.ModelState[nameof(Model.Email)]?.Errors.Count > 0 ? "true" : "false")" />
                <span asp-validation-for="Email" id="Email-error"></span>
            </div>

            <button type="submit" class="btn btn-primary w-full">Send reset link</button>
        </form>
    </div>

    <p class="mt-6 text-center text-sm text-ink-muted">
        Remembered it? <a asp-controller="Account" asp-action="Login" class="link">Back to sign in</a>
    </p>
</section>
